#bind "graphics.h"

fn init_graphics(width: Int, height: Int, title: String) -> Void {
    ext {
        c_init_window(px_width, px_height, px_title);
    }
}

fn close_graphics() -> Void {
    ext {
        c_close_window();
    }
}

fn should_close() -> Bool {
    ext {
        return c_window_should_close();
    }
}

fn not_should_close() -> Bool {
    ext {
        return !c_window_should_close();
    }
}

fn get_screen_width() -> Int {
    ext {
        return c_get_screen_width();
    }
}

fn get_screen_height() -> Int {
    ext {
        return c_get_screen_height();
    }
}

fn begin_frame() -> Void {
    ext {
        c_begin_drawing();
    }
}

fn end_frame() -> Void {
    ext {
        c_end_drawing();
    }
}

fn get_deltatime() -> Float {
    ext {
        return c_get_frame_time();
    }
}

fn get_fps() -> Int {
    ext {
        return c_get_fps();
    }
}

fn is_key_down(key: Int) -> Bool {
    ext {
        return c_is_key_down(px_key);
    }
}

fn is_key_pressed(key: Int) -> Bool {
    ext {
        return c_is_key_pressed(px_key);
    }
}

fn is_mouse_button_down(button: Int) -> Bool {
    ext {
        return c_is_mouse_button_down(px_button);
    }
}

fn get_mouse_x() -> Float {
    ext {
        return c_get_mouse_x();
    }
}

fn get_mouse_y() -> Float {
    ext {
        return c_get_mouse_y();
    }
}

fn clear_background(color: Array(Int)) -> Void {
    ext {
        c_clear_background(px_color);
    }
}

fn draw_rect(x: Float, y: Float, w: Float, h: Float, color: Array(Int)) -> Void {
    ext {
        c_draw_rect(px_x, px_y, px_w, px_h, px_color);
    }
}

fn draw_circle(x: Float, y: Float, radius: Float, color: Array(Int)) -> Void {
    ext {
        c_draw_circle(px_x, px_y, px_radius, px_color);
    }
}

fn draw_line(x1: Float, y1: Float, x2: Float, y2: Float, color: Array(Int)) -> Void {
    ext {
        c_draw_line(px_x1, px_y1, px_x2, px_y2, px_color);
    }
}

fn draw_text(text: String, x: Int, y: Int, size: Int, color: Array(Int)) -> Void {
    ext {
        c_draw_text(px_text, px_x, px_y, px_size, px_color);
    }
}

fn distance(x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
    ext {
        return c_distance(px_x1, px_y1, px_x2, px_y2);
    }
}

fn get_random(min: Int, max: Int) -> Int {
    ext {
        return c_get_random_value(px_min, px_max);
    }
}
