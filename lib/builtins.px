#bind "builtins.h"

fn print_int(x: Int) -> Void {
    ext_c {
        printf("%d\n", px_x);
    }
}

fn print_float(x: Float) -> Void {
    ext_c {
        printf("%f\n", px_x);
    }
}

fn print_string(s: String) -> Void {
    ext_c {
        printf("%s\n", px_s.c_str());
    }
}

fn print_bool(b: Bool) -> Void {
    ext_c {
        printf("%s\n", px_b ? "true" : "false");
    }
}

fn print_pointer(ptr: Void*) -> Void {
    ext_c {
        printf("%p\n", (void *)px_ptr);
    }
}

fn abs(x: Int) -> Int {
    ext_c {
        return abs(px_x);
    }
}

fn max(a: Int, b: Int) -> Int {
    ext_c {
        return _max(px_a, px_b);
    }
}

fn min(a: Int, b: Int) -> Int {
    ext_c {
        return _min(px_a, px_b);
    }
}

fn input_string() -> String {
    ext_c {
        return input_string();
    }
}

fn malloc(size: Int) -> Void* {
    ext_c {
        return c_malloc(px_size);
    }
}

fn free(ptr: Void*) -> Void {
    ext_c {
        c_free(px_ptr);
    }
}

fn memset(ptr: Void*, value: Int, size: Int) -> Void {
    ext_c {
        c_memset(px_ptr, px_value, px_size);
    }
}

fn memcpy(dest: Void*, src: Void*, size: Int) -> Void {
    ext_c {
        c_memcpy(px_dest, px_src, px_size);
    }
}